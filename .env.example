# Movie Planner — required environment.
# Copy to `.env` and fill in the two required secrets.
#
# `compose.yaml`, `compose.infra.yaml`, and `compose.prod.yaml` read these
# variables. Everything not listed here has a sensible default inside the
# compose files.

# PostgreSQL password (REQUIRED — the compose files refuse to start without it).
POSTGRES_PASSWORD=change-me

# PostgreSQL database name (canonical: movie_planner).
POSTGRES_DB=movie_planner

# PostgreSQL user (defaults to `postgres` in the compose files).
# POSTGRES_USER=postgres

# Optional: override the default host ports the compose files publish.
# POSTGRES_PORT=5432
# SERVER_PORT=3000
# CLIENT_PORT=5173

# CORS allow-list, comma-separated. Defaults to localhost in the compose files.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to "true" to enable external scheduled scraping in the worker role.
# The worker always registers schedules from the database; this gates whether
# they actually fire. Disabled by default.
# ENABLE_SCRAPE_CRON=false

# Logging / runtime overrides (optional).
# LOG_LEVEL=info
# TZ=Europe/Paris
# JWT_EXPIRES_IN=24h

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# JWT signing key for authentication tokens. The server refuses to start
# without it. Minimum 32 characters.
# Generate with: openssl rand -base64 64
JWT_SECRET=

# ─── Auth email (SMTP) ────────────────────────────────────────────────────────
# The mailer is auth-only: verification and password-reset emails (ADR 0005).
# Without SMTP_HOST the web role falls back to an in-memory transport
# (messages are captured in-process instead of sent — fine for local dev and
# tests). In PRODUCTION SMTP_HOST is REQUIRED: email verification is
# load-bearing (ADR 0003), so the server refuses to start without it.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Sender identity (defaults mirror the Branding email_from_* defaults).
# SMTP_FROM_NAME=Movie Planner
# SMTP_FROM_ADDRESS=no-reply@movie-planner.local

# Public web origin used to build absolute links in emails (e.g. the
# /verify?token=... target). Defaults to the first ALLOWED_ORIGINS entry.
# PUBLIC_WEB_ORIGIN=http://localhost:3000

# Optional rate-limit overrides. Password reset has independent per-IP and
# per-email budgets to prevent both source spraying and inbox bombing.
# RATE_LIMIT_PASSWORD_RESET_MAX=3
# RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
# RATE_LIMIT_PASSWORD_RESET_EMAIL_MAX=3
# RATE_LIMIT_PASSWORD_RESET_EMAIL_WINDOW_MS=3600000
