# Movie Planner — production environment template.
# Copy to `.env` on the deployment host and fill in the required secrets.
# Everything not listed here has a sensible default inside `compose.prod.yaml`.
#
#   cp .env.prod.example .env
#   # edit .env to set POSTGRES_PASSWORD, JWT_SECRET, ALLOWED_ORIGINS
#   docker compose -f compose.prod.yaml up -d --build
#
# Never commit real values; `.env` is gitignored.

# PostgreSQL password (REQUIRED — compose.prod.yaml refuses to start without it).
POSTGRES_PASSWORD=change-me

# PostgreSQL database name (canonical: movie_planner).
POSTGRES_DB=movie_planner

# PostgreSQL user (defaults to `postgres` in compose.prod.yaml).
# POSTGRES_USER=postgres

# JWT signing key for authentication tokens. The server refuses to start
# without it. Minimum 32 characters.
# Generate with: openssl rand -base64 64
JWT_SECRET=

# The exact public origin browsers use to reach this deployment (scheme +
# host + optional port, no trailing slash). Same-origin SPA requests still
# carry an Origin header and the auth routes reject origins absent from this
# list, so this MUST match the real deployment URL.
#   Example (TLS behind a reverse proxy): https://movies.example.com
#   Example (bare host):                  http://<server-ip>:3000
ALLOWED_ORIGINS=

# Host port the web service publishes (default 3000).
# SERVER_PORT=3000

# ─── Auth email (SMTP) — REQUIRED in production ──────────────────────────────
# Email verification is load-bearing (ADR 0003): the web role refuses to
# start without an SMTP relay. The mailer is auth-only (verification and
# password reset — ADR 0005).
SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Sender identity (defaults mirror the Branding email_from_* defaults).
# SMTP_FROM_NAME=Movie Planner
# SMTP_FROM_ADDRESS=no-reply@movie-planner.local
# Absolute origin for email links (e.g. /verify?token=...). Defaults to the
# first ALLOWED_ORIGINS entry when unset.
# PUBLIC_WEB_ORIGIN=

# Set to "true" to let the worker fire external scheduled scrapes.
# ENABLE_SCRAPE_CRON=false

# Cookies carry the Secure flag by default (correct behind TLS). Set to
# "false" only for a plain-HTTP test deployment, otherwise browsers silently
# reject the auth cookies and every non-login API call returns 403.
# COOKIE_SECURE=true

# Logging / runtime overrides (optional).
# LOG_LEVEL=info
# TZ=Europe/Paris
# JWT_EXPIRES_IN=24h
# IMAGE_TAG=prod
