{
  "name": "movie-planner",
  "version": "0.0.0-development",
  "description": "Theater showtimes aggregator - Full-stack Express.js + React application with PostgreSQL backend",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "scraper",
    "packages/scraper-protocol"
  ],
  "scripts": {
    "dev": "docker compose up --build",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "dev:infra": "docker compose -f compose.infra.yaml up -d",
    "dev:infra:down": "docker compose -f compose.infra.yaml down",
    "dev:infra:logs": "docker compose -f compose.infra.yaml logs -f",
    "build": "npm run server:build && npm run client:build",
    "docker:build": "docker compose up --build -d",
    "docker:build:local": "docker build -t movie-planner:latest .",
    "docker:pull": "docker compose pull",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web worker",
    "docker:restart": "docker compose restart web worker",
    "docker:clean": "docker compose down -v && docker system prune -f",
    "backup": "./scripts/backup-db.sh",
    "restore": "./scripts/restore-db.sh",
    "server:dev": "npm run dev --workspace=@movie-planner/server",
    "server:build": "npm run build --workspace=@movie-planner/server",
    "server:start": "npm start --workspace=@movie-planner/server",
    "server:db:migrate": "npm run db:migrate --workspace=@movie-planner/server",
    "server:db:init": "npm run db:init --workspace=@movie-planner/server",
    "scraper:dev": "npm run dev --workspace=@movie-planner/scraper",
    "scraper:consumer": "RUN_MODE=consumer npm run dev --workspace=@movie-planner/scraper",
    "scraper:build": "npm run build --workspace=@movie-planner/scraper",
    "scraper:start": "npm start --workspace=@movie-planner/scraper",
    "web:start": "npm start --workspace=@movie-planner/server",
    "worker:start": "npm start --workspace=@movie-planner/scraper",
    "client:dev": "npm run dev --workspace=@movie-planner/client",
    "client:build": "npm run build --workspace=@movie-planner/client",
    "client:preview": "npm run preview --workspace=@movie-planner/client",
    "install:all": "npm install",
    "clean": "rm -rf server/dist client/dist scraper/dist server/node_modules client/node_modules scraper/node_modules node_modules package-lock.json client/package-lock.json server/package-lock.json scraper/package-lock.json",
    "test": "npm test --workspaces --if-present",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "integration-test": "./scripts/integration-test.sh",
    "prepare": "husky || true"
  },
  "keywords": [
    "theater",
    "showtimes",
    "scraper",
    "aggregator",
    "express",
    "react",
    "postgresql",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "fallow": "^2.89.0",
    "husky": "^9.1.7"
  },
  "overrides": {
    "qs": "6.15.2",
    "brace-expansion": "5.0.9"
  }
}
