# Movie Planner — host-application (Node 24) development overrides.
# Append to `.env` after copying `.env.example`:
#
#   cat .env.example .env.dev.example > .env
#
# Used only when running the client / server / scraper on the host via
# `npm run dev:infra` (Postgres in Docker). The fully-Dockerized path
# (`npm run dev`) does not need these.

# ── PostgreSQL (host-app points at the local Docker port) ────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=movie_planner
POSTGRES_USER=postgres

# ── Dev server ports ─────────────────────────────────────────────────────────
SERVER_PORT=3000
CLIENT_PORT=5173
NODE_ENV=development

# ── App defaults ─────────────────────────────────────────────────────────────
TZ=Europe/Paris
LOG_LEVEL=info
JWT_EXPIRES_IN=24h
PORT=3000

# ── Scraper (host-app) ───────────────────────────────────────────────────────
SCRAPE_MODE=weekly
SCRAPE_DAYS=7
SCRAPE_THEATER_DELAY_MS=3000
SCRAPE_MOVIE_DELAY_MS=500
SCRAPER_CONCURRENCY=2
SCRAPE_DELAY_MS=1000

# ── Advanced (optional, uncomment to override) ───────────────────────────────
# AUTO_MIGRATE=true
# Set to false for HTTP-only development (no TLS). The browser will otherwise
# silently reject cookies carrying the Secure flag and every non-login API
# call will return 403 "CSRF token missing or invalid".
COOKIE_SECURE=false
# REFRESH_TOKEN_EXPIRY=7d
